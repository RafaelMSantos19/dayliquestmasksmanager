rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      // Quests subcollection
      match /quests/{questId} {
        allow get, create, update, delete: if isOwner(userId) && isValidId(questId);
        allow list: if isOwner(userId);
      }

      // Rewards subcollection
      match /rewards/{rewardId} {
        allow get, create, update, delete: if isOwner(userId) && isValidId(rewardId);
        allow list: if isOwner(userId);
      }

      // History subcollection
      match /history/{historyId} {
        allow get, create, update, delete: if isOwner(userId) && isValidId(historyId);
        allow list: if isOwner(userId);
      }
    }
  }
}
